# Supabase: Project Settings > Database > Connection string > Session pooler (5432).
# NO uses el Transaction pooler (6543): rompe los prepared statements de Npgsql.
#
# IMPORTANTE - formato: envolve TODO el valor en comillas simples (el valor tiene
# espacios en "SSL Mode" y "Trust Server Certificate"), y NO pongas comillas
# alrededor de la password. Comillas dentro del valor rompen el parser de DotNetEnv
# con "Syntax error (line 1, column 1)". Si tu password tiene ';' o '=', generá
# una nueva sin esos caracteres en vez de intentar escaparla.
DB_CONNECTION='Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true'
JWT_KEY=CambiarEstaClaveEnProduccion123!
JWT_ISSUER=MarketplaceApi
JWT_AUDIENCE=MarketplaceClient
ADMIN_EMAIL=admin@encoya.com
ADMIN_PASSWORD=CambiarEstaPasswordEnProduccion

# Origenes permitidos por CORS, separados por coma. Solo se aplica fuera de
# Development (en Development se permite cualquier origen).
CORS_ORIGINS=https://encoya.com,https://www.encoya.com
